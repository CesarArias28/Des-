---
import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
}

const { 
	title = "Des | SMM, UGC & Mentoría de Oratoria", 
	description = "Portafolio y servicios de Des. Estrategia de comunicación digital, creación de contenido UGC y mentorías de oratoria para marcas conscientes y creadores." 
} = Astro.props;
---

<!doctype html>
<html lang="es" class="scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/png" href="/favicon.png" />
		<link rel="shortcut icon" type="image/png" href="/favicon.png" />
		<meta name="generator" content={Astro.generator} />
		
		<!-- SEO Meta Tags -->
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="author" content="Des" />
		
		<!-- Open Graph / WhatsApp / Facebook -->
		<meta property="og:type" content="website" />
		<meta property="og:url" content="https://desmeneses.com" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content="https://desmeneses.com/og-image.png" />
		<meta property="og:image:secure_url" content="https://desmeneses.com/og-image.png" />
		<meta property="og:image:type" content="image/png" />
		
		<!-- Twitter -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content="https://desmeneses.com/og-image.png" />
		<link rel="apple-touch-icon" href="/og-image.png" />

		<!-- Google Fonts -->
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Bodoni+Moda:ital,opsz,wght@0,6..96,400..900;1,6..96,400..900&family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;0,700;1,300;1,400;1,500;1,600;1,700&family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&display=swap" rel="stylesheet" />
	</head>
	<body class="bg-bone text-charcoal font-sans antialiased min-h-screen flex flex-col selection:bg-sage/20 selection:text-charcoal">
		<slot />
	</body>
</html>
