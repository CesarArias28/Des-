---
interface Props {
  isTransparent?: boolean;
}

const { isTransparent = false } = Astro.props;
---

<header 
  class={`z-50 w-full transition-all duration-500 ${
    isTransparent 
      ? 'absolute top-0 left-0 bg-transparent border-b border-transparent text-[#FAF8F5]' 
      : 'sticky top-0 border-b border-soft-sand/40 bg-bone/80 backdrop-blur-md text-charcoal'
  }`} 
  id="navbar"
  data-transparent={isTransparent ? "true" : "false"}
>
  <div class="mx-auto flex max-w-7xl items-center justify-between px-6 py-4 md:px-12 transition-all duration-500" id="navbar-container">
    <!-- Logo -->
    <a href="#" class="group font-serif text-2xl font-semibold tracking-wide flex items-center gap-1 transition-colors duration-500" id="navbar-logo">
      Des<span class="text-terracotta group-hover:translate-x-0.5 transition-transform duration-300">.</span>
    </a>

    <!-- Desktop Navigation Links -->
    <nav class="hidden md:flex items-center gap-8 text-sm font-medium tracking-wider uppercase" id="navbar-nav">
      <a href="#servicios" class="transition-colors duration-300 text-xs">Servicios</a>
      <a href="#sobre-mi" class="transition-colors duration-300 text-xs">Sobre Mí</a>
      <a href="#portafolio" class="transition-colors duration-300 text-xs">Portafolio UGC</a>
      <a href="#faq" class="transition-colors duration-300 text-xs">FAQ</a>
    </nav>

    <!-- Desktop Right Group: Social Media Icons + Action Button -->
    <div class="hidden md:flex items-center gap-6">
      
      <!-- Social Media Icons (Instagram, TikTok, LinkedIn, YouTube) -->
      <div class="flex items-center gap-3.5" id="navbar-socials">
        <!-- Instagram -->
        <a 
          href="https://instagram.com/desmenesesm" 
          target="_blank" 
          rel="noopener noreferrer" 
          class="social-icon transition-all duration-300 hover:scale-110" 
          aria-label="Instagram de Des"
        >
          <svg class="h-4 w-4 fill-current" viewBox="0 0 24 24">
            <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
          </svg>
        </a>

        <!-- TikTok -->
        <a 
          href="https://tiktok.com/@desmenesesm" 
          target="_blank" 
          rel="noopener noreferrer" 
          class="social-icon transition-all duration-300 hover:scale-110" 
          aria-label="TikTok de Des"
        >
          <svg class="h-4 w-4 fill-current" viewBox="0 0 24 24">
            <path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.82.57-1.31 1.56-1.31 2.56.02.94.52 1.84 1.33 2.33 1.07.64 2.47.62 3.53-.06.74-.48 1.18-1.3 1.24-2.17.06-2.92.02-5.84.03-8.77-.01-2.92-.01-5.84-.01-8.76z"/>
          </svg>
        </a>

        <!-- LinkedIn -->
        <a 
          href="https://linkedin.com/in/desmenesesm" 
          target="_blank" 
          rel="noopener noreferrer" 
          class="social-icon transition-all duration-300 hover:scale-110" 
          aria-label="LinkedIn de Des"
        >
          <svg class="h-4 w-4 fill-current" viewBox="0 0 24 24">
            <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
          </svg>
        </a>

        <!-- YouTube -->
        <a 
          href="https://youtube.com/@desmenesesm" 
          target="_blank" 
          rel="noopener noreferrer" 
          class="social-icon transition-all duration-300 hover:scale-110" 
          aria-label="YouTube de Des"
        >
          <svg class="h-4 w-4 fill-current" viewBox="0 0 24 24">
            <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
          </svg>
        </a>
      </div>

      <!-- Action Button -->
      <a 
        href="#contacto" 
        id="navbar-btn"
        class="inline-block rounded-full border px-6 py-2.5 text-xs font-semibold uppercase tracking-wider transition-all duration-500"
      >
        Trabajemos juntos
      </a>
    </div>

    <!-- Mobile Menu Button -->
    <button 
      id="menu-btn" 
      class="flex h-10 w-10 items-center justify-center rounded-full border transition-all duration-500 focus:outline-none md:hidden"
      aria-label="Abrir menú"
    >
      <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path id="menu-icon-1" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16" class="transition-transform duration-300 origin-center"></path>
        <path id="menu-icon-2" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 12h16" class="opacity-100 transition-opacity duration-300"></path>
        <path id="menu-icon-3" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 18h16" class="transition-transform duration-300 origin-center"></path>
      </svg>
    </button>
  </div>

  <!-- Mobile Dropdown Menu -->
  <div 
    id="mobile-menu" 
    class="pointer-events-none absolute top-full left-0 w-full overflow-hidden bg-bone border-b border-soft-sand/65 opacity-0 shadow-lg transition-all duration-300 ease-in-out md:hidden text-warm-gray"
    style="max-height: 0px;"
  >
    <nav class="flex flex-col gap-4 px-8 py-6 text-base font-medium tracking-wide">
      <a href="#servicios" class="mobile-link hover:text-charcoal transition-colors py-2">Servicios</a>
      <a href="#sobre-mi" class="mobile-link hover:text-charcoal transition-colors py-2">Sobre Mí</a>
      <a href="#portafolio" class="mobile-link hover:text-charcoal transition-colors py-2">Portafolio UGC</a>
      <a href="#faq" class="mobile-link hover:text-charcoal transition-colors py-2">FAQ</a>
      
      <!-- Mobile Social Icons Row -->
      <div class="flex items-center gap-6 py-2 border-t border-soft-sand/60">
        <a href="https://instagram.com/desmenesesm" target="_blank" rel="noopener noreferrer" class="text-warm-gray hover:text-charcoal transition-colors" aria-label="Instagram">
          <svg class="h-5 w-5 fill-current" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
        </a>
        <a href="https://tiktok.com/@desmenesesm" target="_blank" rel="noopener noreferrer" class="text-warm-gray hover:text-charcoal transition-colors" aria-label="TikTok">
          <svg class="h-5 w-5 fill-current" viewBox="0 0 24 24"><path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.82.57-1.31 1.56-1.31 2.56.02.94.52 1.84 1.33 2.33 1.07.64 2.47.62 3.53-.06.74-.48 1.18-1.3 1.24-2.17.06-2.92.02-5.84.03-8.77-.01-2.92-.01-5.84-.01-8.76z"/></svg>
        </a>
        <a href="https://linkedin.com/in/desmenesesm" target="_blank" rel="noopener noreferrer" class="text-warm-gray hover:text-charcoal transition-colors" aria-label="LinkedIn">
          <svg class="h-5 w-5 fill-current" viewBox="0 0 24 24"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>
        </a>
        <a href="https://youtube.com/@desmenesesm" target="_blank" rel="noopener noreferrer" class="text-warm-gray hover:text-charcoal transition-colors" aria-label="YouTube">
          <svg class="h-5 w-5 fill-current" viewBox="0 0 24 24"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
        </a>
      </div>

      <div class="h-px bg-soft-sand/60 my-1"></div>
      <a 
        href="#contacto" 
        class="mobile-link inline-block rounded-full border border-sage bg-sage text-[#FAF8F5] text-center px-6 py-3 text-sm font-semibold uppercase tracking-wider hover:bg-sage/90 transition-all duration-300"
      >
        Trabajemos juntos
      </a>
    </nav>
  </div>
</header>

<script>
  const menuBtn = document.getElementById('menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  const menuIcon1 = document.getElementById('menu-icon-1');
  const menuIcon2 = document.getElementById('menu-icon-2');
  const menuIcon3 = document.getElementById('menu-icon-3');
  const mobileLinks = document.querySelectorAll('.mobile-link');

  let isMenuOpen = false;

  function toggleMenu() {
    isMenuOpen = !isMenuOpen;
    
    if (isMenuOpen && mobileMenu && menuIcon1 && menuIcon2 && menuIcon3) {
      // Open menu
      mobileMenu.style.maxHeight = '420px';
      mobileMenu.classList.remove('pointer-events-none');
      mobileMenu.classList.add('opacity-100');
      
      // Animate hamburger to X
      menuIcon1.setAttribute('d', 'M6 18L18 6');
      menuIcon2.classList.add('opacity-0');
      menuIcon3.setAttribute('d', 'M6 6l12 12');
    } else if (mobileMenu && menuIcon1 && menuIcon2 && menuIcon3) {
      // Close menu
      mobileMenu.style.maxHeight = '0px';
      mobileMenu.classList.add('pointer-events-none');
      mobileMenu.classList.remove('opacity-100');
      
      // Animate X back to hamburger
      menuIcon1.setAttribute('d', 'M4 6h16');
      menuIcon2.classList.remove('opacity-0');
      menuIcon3.setAttribute('d', 'M4 18h16');
    }
  }

  menuBtn?.addEventListener('click', toggleMenu);
  
  mobileLinks.forEach(link => {
    link.addEventListener('click', () => {
      if (isMenuOpen) toggleMenu();
    });
  });

  // Dynamic style changes on scroll
  const navbar = document.getElementById('navbar');
  const navbarContainer = document.getElementById('navbar-container');
  const navbarLogo = document.getElementById('navbar-logo');
  const navbarNav = document.getElementById('navbar-nav');
  const navbarBtn = document.getElementById('navbar-btn');
  const navbarSocials = document.getElementById('navbar-socials');
  const isTransparent = navbar?.getAttribute('data-transparent') === 'true';

  function applyTransparentStyles() {
    if (!navbar) return;
    navbar.className = "absolute top-0 left-0 w-full z-50 bg-transparent border-b border-transparent text-[#FAF8F5] transition-all duration-500";
    navbarContainer?.classList.remove('py-2');
    navbarContainer?.classList.add('py-4');
    
    if (navbarLogo) navbarLogo.className = "group font-serif text-2xl font-semibold tracking-wide text-[#FAF8F5] flex items-center gap-1 transition-colors duration-500";
    
    if (navbarNav) {
      const links = navbarNav.querySelectorAll('a');
      links.forEach(l => {
        l.className = "hover:text-soft-sand transition-colors duration-300 text-xs text-[#FAF8F5]/85";
      });
    }

    if (navbarSocials) {
      const socialLinks = navbarSocials.querySelectorAll('.social-icon');
      socialLinks.forEach(l => {
        l.className = "social-icon text-[#FAF8F5]/80 hover:text-[#FAF8F5] transition-all duration-300 hover:scale-110";
      });
    }
    
    if (navbarBtn) {
      navbarBtn.className = "inline-block rounded-full border border-[#FAF8F5] px-6 py-2.5 text-xs font-semibold uppercase tracking-wider text-[#FAF8F5] hover:bg-[#FAF8F5] hover:text-charcoal transition-all duration-500";
    }
    
    if (menuBtn) {
      menuBtn.className = "flex h-10 w-10 items-center justify-center rounded-full border border-[#FAF8F5]/40 text-[#FAF8F5] hover:bg-[#FAF8F5]/10 transition-all duration-500 focus:outline-none md:hidden";
    }
  }

  function applySolidStyles() {
    if (!navbar) return;
    navbar.className = "fixed top-0 left-0 w-full z-50 bg-bone/90 border-b border-soft-sand/40 backdrop-blur-md text-charcoal shadow-sm transition-all duration-500";
    navbarContainer?.classList.remove('py-4');
    navbarContainer?.classList.add('py-2');
    
    if (navbarLogo) navbarLogo.className = "group font-serif text-2xl font-semibold tracking-wide text-charcoal flex items-center gap-1 transition-colors duration-500";
    
    if (navbarNav) {
      const links = navbarNav.querySelectorAll('a');
      links.forEach(l => {
        l.className = "hover:text-charcoal transition-colors duration-300 text-xs text-warm-gray";
      });
    }

    if (navbarSocials) {
      const socialLinks = navbarSocials.querySelectorAll('.social-icon');
      socialLinks.forEach(l => {
        l.className = "social-icon text-warm-gray hover:text-charcoal transition-all duration-300 hover:scale-110";
      });
    }
    
    if (navbarBtn) {
      navbarBtn.className = "inline-block rounded-full border border-sage px-6 py-2.5 text-xs font-semibold uppercase tracking-wider text-sage hover:bg-sage hover:text-bone transition-all duration-500 hover:shadow-md hover:shadow-sage/10";
    }
    
    if (menuBtn) {
      menuBtn.className = "flex h-10 w-10 items-center justify-center rounded-full border border-soft-sand/60 text-charcoal hover:bg-soft-sand/50 transition-all duration-500 focus:outline-none md:hidden";
    }
  }

  // Initialize styles on mount
  if (isTransparent) {
    applyTransparentStyles();
  } else {
    // Default solid sticky mode
    if (navbar) {
      navbar.className = "sticky top-0 z-50 w-full bg-bone/80 border-b border-soft-sand/40 backdrop-blur-md text-charcoal transition-all duration-500";
      applySolidStyles();
      navbar.className = "sticky top-0 z-50 w-full bg-bone/80 border-b border-soft-sand/40 backdrop-blur-md text-charcoal transition-all duration-500";
    }
  }

  // Listen to scroll events
  window.addEventListener('scroll', () => {
    if (isTransparent) {
      if (window.scrollY > 50) {
        applySolidStyles();
      } else {
        applyTransparentStyles();
      }
    } else {
      if (window.scrollY > 50) {
        navbarContainer?.classList.remove('py-4');
        navbarContainer?.classList.add('py-2');
      } else {
        navbarContainer?.classList.remove('py-2');
        navbarContainer?.classList.add('py-4');
      }
    }
  });
</script>
