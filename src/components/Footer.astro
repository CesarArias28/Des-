---
---

<footer class="bg-soft-sand/40 border-t border-soft-sand/80 py-16 px-6 md:px-12 text-charcoal" id="contacto">
  <div class="mx-auto max-w-7xl">
    
    <!-- Top Grid -->
    <div class="grid grid-cols-1 md:grid-cols-12 gap-10 md:gap-16 pb-12 border-b border-soft-sand/80">
      
      <!-- Brand column -->
      <div class="md:col-span-5 flex flex-col gap-4">
        <a href="#" class="font-serif text-3xl font-semibold tracking-wide text-charcoal">
          Des<span class="text-terracotta">.</span>
        </a>
        <p class="text-warm-gray text-sm leading-relaxed max-w-sm">
          Licenciada en Comunicación Social, creadora de contenido UGC, Social Media Manager y mentora de oratoria. Conectando marcas conscientes y creadores con su audiencia real a través de estrategias con propósito.
        </p>
        
        <!-- Socials -->
        <div class="flex items-center gap-4 mt-2">
          <!-- Instagram -->
          <a 
            href="https://instagram.com/desmenesesm" 
            target="_blank" 
            rel="noopener noreferrer" 
            class="flex h-10 w-10 items-center justify-center rounded-full border border-warm-gray/30 text-warm-gray hover:text-charcoal hover:border-charcoal hover:bg-soft-sand transition-all duration-300"
            aria-label="Instagram"
          >
            <svg class="h-4.5 w-4.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
              <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
              <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
            </svg>
          </a>
          
          <!-- TikTok -->
          <a 
            href="https://tiktok.com/@desmenesesm" 
            target="_blank" 
            rel="noopener noreferrer" 
            class="flex h-10 w-10 items-center justify-center rounded-full border border-warm-gray/30 text-warm-gray hover:text-charcoal hover:border-charcoal hover:bg-soft-sand transition-all duration-300"
            aria-label="TikTok"
          >
            <svg class="h-4.5 w-4.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M9 12a4 4 0 1 0 4 4V4a5 5 0 0 0 5 5"></path>
            </svg>
          </a>
          
          <!-- LinkedIn -->
          <a 
            href="https://linkedin.com" 
            target="_blank" 
            rel="noopener noreferrer" 
            class="flex h-10 w-10 items-center justify-center rounded-full border border-warm-gray/30 text-warm-gray hover:text-charcoal hover:border-charcoal hover:bg-soft-sand transition-all duration-300"
            aria-label="LinkedIn"
          >
            <svg class="h-4.5 w-4.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path>
              <rect x="2" y="9" width="4" height="12"></rect>
              <circle cx="4" cy="4" r="2"></circle>
            </svg>
          </a>
        </div>
      </div>
      
      <!-- Links column -->
      <div class="md:col-span-3 flex flex-col gap-4">
        <h3 class="font-serif text-lg font-medium text-charcoal tracking-wide">Explorar</h3>
        <nav class="flex flex-col gap-3 text-sm text-warm-gray">
          <a href="#servicios" class="hover:text-charcoal transition-colors">Servicios</a>
          <a href="#sobre-mi" class="hover:text-charcoal transition-colors">Sobre Mí</a>
          <a href="#portafolio" class="hover:text-charcoal transition-colors">Portafolio UGC</a>
          <a href="#faq" class="hover:text-charcoal transition-colors">Preguntas Frecuentes</a>
        </nav>
      </div>
      
      <!-- Contact/Newsletter Form column -->
      <div class="md:col-span-4 flex flex-col gap-4">
        <h3 class="font-serif text-lg font-medium text-charcoal tracking-wide">Trabajemos Juntas</h3>
        <p class="text-warm-gray text-sm leading-relaxed">
          ¿Tienes un proyecto en mente? Escríbeme y diseñemos algo increíble.
        </p>
        
        <form class="flex flex-col gap-2 mt-2" onsubmit="event.preventDefault(); alert('¡Gracias! Me pondré en contacto muy pronto.');">
          <div class="relative flex items-center">
            <input 
              type="email" 
              placeholder="Tu correo electrónico" 
              required
              class="w-full bg-bone border border-soft-sand px-4 py-3 pr-12 rounded-full text-sm text-charcoal placeholder-warm-gray/60 focus:outline-none focus:border-sage focus:ring-1 focus:ring-sage/20 transition-all duration-300"
            />
            <button 
              type="submit" 
              class="absolute right-1 top-1 bottom-1 bg-sage text-bone hover:bg-sage/90 px-4 rounded-full flex items-center justify-center transition-colors duration-300"
              aria-label="Enviar"
            >
              <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
              </svg>
            </button>
          </div>
          <span class="text-[10px] text-warm-gray/70 pl-3">
            O escríbeme directamente a <a href="mailto:hola@desmenesesm.com" class="underline hover:text-charcoal">hola@desmenesesm.com</a>
          </span>
        </form>
      </div>

    </div>

    <!-- Bottom Credits -->
    <div class="flex flex-col sm:flex-row items-center justify-between gap-4 mt-8 text-xs text-warm-gray">
      <p>&copy; {new Date().getFullYear()} Des. Todos los derechos reservados.</p>
      <p class="flex items-center gap-1">
        Diseñado con <span class="text-terracotta">♥</span> para marcas conscientes.
      </p>
    </div>
    
  </div>
</footer>
