---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import PortfolioUGC from '../components/PortfolioUGC.jsx';
import TestimonialCarousel from '../components/TestimonialCarousel.jsx';
import FAQ from '../components/FAQ.jsx';
import { Image } from 'astro:assets';
import bioActualizada from '../assets/bio_actualizada.png';
import bento1 from '../assets/bento_1.jpg';
import bento2 from '../assets/bento_2.jpg';
import bento3 from '../assets/bento_3.jpg';
import bento4 from '../assets/bento_4.jpg';
---

<Layout title="Des | Social Media Manager, UGC & Mentora de Oratoria" description="Portafolio y servicios de Des. Licenciada en Comunicación Social especializada en la creación de contenido UGC y mentoría de oratoria.">
  <Navbar isTransparent={true} />
  
  <main class="flex-grow">
    <!-- Hero Section -->
    <section class="relative min-h-screen flex items-center justify-start overflow-hidden px-6 md:px-12 lg:px-24 py-32 bg-charcoal">
      <!-- Background Video -->
      <video 
        class="absolute inset-0 w-full h-full object-cover pointer-events-none"
        muted
        loop
        playsInline
        autoPlay
      >
        <source src="/reels/Hero_nuevo.mov" type="video/quicktime" />
        <source src="/reels/Hero_nuevo.mov" />
      </video>
      
      <!-- Charcoal overlay for legibility -->
      <div class="absolute inset-0 bg-gradient-to-r from-charcoal/90 via-charcoal/60 to-transparent"></div>
      
      <!-- Subtle top-down overlay to blend with transparent header -->
      <div class="absolute inset-0 bg-gradient-to-b from-charcoal/60 via-transparent to-transparent"></div>

      <div class="mx-auto max-w-7xl w-full relative z-10 text-left">
        <div class="max-w-2xl flex flex-col gap-6">
          <span class="text-xs font-semibold tracking-[0.25em] uppercase text-[#CDB396]">
            HOLA, SOY DES
          </span>
          <h1 class="font-serif text-4xl sm:text-5xl md:text-6xl font-medium tracking-tight text-[#FAF8F5] leading-[1.12]">
            Hago que tu marca <br />
            <span class="italic text-[#CDB396]">se vea, conecte y crezca.</span>
          </h1>
          <p class="text-soft-sand/85 text-base md:text-lg leading-relaxed max-w-xl">
            Ayudo a marcas a encontrar su forma de comunicar, crear contenido con intención y construir una presencia digital que realmente las represente. Porque no se trata solo de estar en redes, sino de <strong class="font-semibold text-[#CDB396]">conectar con las personas correctas y hacer que te recuerden.</strong>
          </p>
          
          <!-- Segmented CTAs -->
          <div class="flex flex-col sm:flex-row gap-4 mt-4">
            <a 
              href="#servicios" 
              class="inline-block text-center rounded-full bg-[#FAF8F5] px-8 py-4 text-xs font-semibold uppercase tracking-widest text-charcoal hover:bg-[#FAF8F5]/90 hover:shadow-lg hover:shadow-white/10 transition-all duration-300"
            >
              Soy una Marca
            </a>
            <a 
              href="#contacto" 
              class="inline-block text-center rounded-full border border-[#FAF8F5]/60 px-8 py-4 text-xs font-semibold uppercase tracking-widest text-[#FAF8F5] hover:bg-[#FAF8F5] hover:text-charcoal hover:border-[#FAF8F5] transition-all duration-300"
            >
              Quiero una Mentoría
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Sobre Mí Section -->
    <section class="min-h-[70vh] lg:min-h-[75vh] flex items-center justify-center py-24 sm:py-32 lg:py-40 px-6 md:px-12 lg:px-24 bg-[#F7F4EF] border-b border-soft-sand/30" id="sobre-mi">
      <div class="mx-auto max-w-[1600px] w-full">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
          
          <!-- Text left -->
          <div class="lg:col-span-7 flex flex-col gap-6 text-warm-gray text-base lg:text-lg leading-relaxed">
            <span class="text-xs font-semibold tracking-[0.25em] uppercase text-warm-gray">Sobre Mí</span>
            
            <p class="text-charcoal font-serif text-xl sm:text-2xl italic leading-snug border-l-2 border-[#CDB396] pl-4 py-1 text-left my-2">
              “Una marca empieza a conectar cuando encuentra su propia forma de comunicar.”
            </p>

            <p>
              Soy <strong class="text-charcoal font-semibold">Licenciada en Comunicación Social</strong> y llevo 8 años trabajando en comunicación y redes sociales, ayudando a marcas y personas a encontrar su voz y comunicar lo que hacen de una forma auténtica.
            </p>
            <p>
              Creo estrategias, gestiono redes y desarrollo contenido UGC, pero mi trabajo también va más allá de las marcas. Dicto talleres y acompaño a personas a mejorar su comunicación, construir su marca personal y aprender a mostrar lo que hacen con seguridad y propósito.
            </p>
            <p>
              Para mí, comunicar no es simplemente publicar o seguir tendencias. Me gusta entender qué hay detrás de cada proyecto, encontrar eso que lo hace diferente y convertirlo en ideas, contenido y estrategias que conecten con las personas correctas.
            </p>
            <p>
              Después de 8 años hay algo que tengo clarísimo: puedes tener una idea increíble, pero si no sabes comunicarla, es difícil que los demás vean todo su valor.
            </p>
            <p class="font-semibold text-charcoal text-lg">
              Y ahí es donde entro yo.
            </p>
            
            <!-- Signature & Trigger Button -->
            <div class="mt-4 flex flex-col sm:flex-row sm:items-center justify-between gap-6 border-t border-soft-sand/80 pt-6">
              <div class="flex flex-col gap-1">
                <span class="font-serif text-2xl italic text-charcoal">Des.</span>
                <span class="text-xs uppercase tracking-wider text-warm-gray/80">Comunicadora & Creadora</span>
              </div>
              <a
                href="#contacto"
                class="inline-flex items-center justify-center gap-2 rounded-full bg-sage px-8 py-4 text-xs font-semibold uppercase tracking-wider text-[#FAF8F5] hover:bg-sage/90 shadow-md hover:shadow-lg transition-all duration-300 cursor-pointer"
              >
                <span>Reservar Mentoría 1:1</span>
                <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                </svg>
              </a>
            </div>
          </div>

          <!-- Editorial Image right: Bio_actualizada -->
          <div class="lg:col-span-5 relative flex justify-center">
            <div class="relative w-full max-w-lg rounded-[28px] overflow-hidden shadow-2xl group">
              <Image 
                src={bioActualizada} 
                alt="Des - Licenciada en Comunicación Social" 
                class="w-full h-auto object-cover group-hover:scale-[1.02] transition-transform duration-700 ease-out"
                width={1200}
                height={1600}
              />
            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- Los 3 Pilares Section - Bento Grid Rediseñado Fiel a la Referencia -->
    <section class="bg-bone py-12 sm:py-16 lg:py-20 px-3 sm:px-6 lg:px-8 border-t border-soft-sand/30" id="servicios">
      
      <!-- Grid de 6 Bloques (3 Filas x 2 Columnas) -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-3 sm:gap-4 lg:gap-6 w-full max-w-none">

        <!-- ROW 1 - CARD 1 (TEXTO CLARO): Mentoría de Oratoria -->
        <div class="bg-[#EFECE6] text-[#242220] p-8 sm:p-12 lg:p-16 flex flex-col justify-between items-start min-h-[460px] sm:min-h-[520px] lg:min-h-[580px] rounded-[24px] sm:rounded-[32px] shadow-sm hover:shadow-xl transition-all duration-500">
          <div class="flex flex-col gap-4">
            <span class="text-xs font-semibold uppercase tracking-[0.25em] text-[#7A746E]">
              PROGRAMA 1:1 • PERSONALIZADO
            </span>
            <h2 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-medium uppercase tracking-tight leading-[1.05] text-[#242220]">
              MENTORÍA DE ORATORIA
            </h2>
            <div class="h-[1px] w-12 bg-[#242220]/20 my-1"></div>
            <p class="text-sm sm:text-base font-normal leading-relaxed text-[#524D47] max-w-xl">
              Pierde el miedo a la cámara, domina tu voz y construye una comunidad leal para monetizar tu presencia digital con autenticidad.
            </p>
          </div>
          
          <a 
            href="#contacto" 
            class="inline-flex items-center gap-2 rounded-full bg-[#242220] text-[#FAF8F5] px-7 py-3.5 text-xs font-medium uppercase tracking-wider hover:bg-[#3B3835] hover:scale-105 transition-all duration-300 shadow-md"
          >
            <span>reservar plaza 1:1</span>
            <span>&rarr;</span>
          </a>
        </div>

        <!-- ROW 1 - CARD 2 (IMAGEN 1): bento_1.jpg -->
        <div class="relative min-h-[460px] sm:min-h-[520px] lg:min-h-[580px] rounded-[24px] sm:rounded-[32px] overflow-hidden group shadow-sm hover:shadow-xl transition-all duration-500">
          <Image 
            src={bento1} 
            alt="Des - Mentora de Oratoria" 
            class="w-full h-full object-cover group-hover:scale-[1.03] transition-transform duration-700 ease-out"
            width={1200}
            height={1000}
          />
        </div>

        <!-- ROW 2 - CARD 3 (IMAGEN 2): bento_2.jpg -->
        <div class="relative min-h-[460px] sm:min-h-[520px] lg:min-h-[580px] rounded-[24px] sm:rounded-[32px] overflow-hidden group order-2 md:order-1 shadow-sm hover:shadow-xl transition-all duration-500">
          <Image 
            src={bento2} 
            alt="Des - Creadora de Contenido UGC" 
            class="w-full h-full object-cover group-hover:scale-[1.03] transition-transform duration-700 ease-out"
            width={1200}
            height={1000}
          />
        </div>

        <!-- ROW 2 - CARD 4 (TEXTO OSCURO): Creación de Contenido UGC -->
        <div class="bg-[#242220] text-[#FAF8F5] p-8 sm:p-12 lg:p-16 flex flex-col justify-between items-start gap-4 min-h-[460px] sm:min-h-[520px] lg:min-h-[580px] rounded-[24px] sm:rounded-[32px] order-1 md:order-2 shadow-sm hover:shadow-xl transition-all duration-500">
          <div class="flex flex-col gap-4">
            <span class="text-xs font-semibold uppercase tracking-[0.25em] text-[#CDB396]">
              CONTENIDO 9:16 ENFOCADO A CONVERSIÓN
            </span>
            <h2 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-medium uppercase tracking-tight leading-[1.05] text-[#FAF8F5]">
              CREACIÓN DE CONTENIDO UGC
            </h2>
            <div class="h-[1px] w-12 bg-white/20 my-1"></div>
            <p class="text-sm sm:text-base font-normal leading-relaxed text-[#FAF8F5]/80 max-w-xl">
              Vídeos orgánicos y anuncios de alto impacto con ganchos de retención pensados para marcas de belleza, moda y lifestyle.
            </p>
          </div>
          
          <a 
            href="#portafolio" 
            class="inline-flex items-center gap-2 rounded-full bg-[#EFECE6] text-[#242220] px-7 py-3.5 text-xs font-medium uppercase tracking-wider hover:bg-white hover:scale-105 transition-all duration-300 shadow-md"
          >
            <span>solicitar paquete UGC</span>
            <span>&rarr;</span>
          </a>
        </div>

        <!-- ROW 3 - CARD 5 (TEXTO CLARO): Social Media Management -->
        <div class="bg-[#EFECE6] text-[#242220] p-8 sm:p-12 lg:p-16 flex flex-col justify-between items-start gap-4 min-h-[460px] sm:min-h-[520px] lg:min-h-[580px] rounded-[24px] sm:rounded-[32px] order-3 shadow-sm hover:shadow-xl transition-all duration-500">
          <div class="flex flex-col gap-4">
            <span class="text-xs font-semibold uppercase tracking-[0.25em] text-[#7A746E]">
              MARCAS E-COMMERCE & ESTRATEGIA
            </span>
            <h2 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-medium uppercase tracking-tight leading-[1.05] text-[#242220]">
              SOCIAL MEDIA MANAGEMENT
            </h2>
            <div class="h-[1px] w-12 bg-[#242220]/20 my-1"></div>
            <p class="text-sm sm:text-base font-normal leading-relaxed text-[#524D47] max-w-xl">
              Estrategia integral de comunicación digital, auditoría de canales y dirección creativa respaldada por Licenciatura en Comunicación.
            </p>
          </div>
          
          <a 
            href="#contacto" 
            class="inline-flex items-center gap-2 rounded-full bg-[#242220] text-[#FAF8F5] px-7 py-3.5 text-xs font-medium uppercase tracking-wider hover:bg-[#3B3835] hover:scale-105 transition-all duration-300 shadow-md"
          >
            <span>consultar servicio SMM</span>
            <span>&rarr;</span>
          </a>
        </div>

        <!-- ROW 3 - CARD 6 (IMAGEN 3): bento_3.jpg -->
        <div class="relative min-h-[460px] sm:min-h-[520px] lg:min-h-[580px] rounded-[24px] sm:rounded-[32px] overflow-hidden group order-4 shadow-sm hover:shadow-xl transition-all duration-500">
          <Image 
            src={bento3} 
            alt="Des - Social Media Manager" 
            class="w-full h-full object-cover group-hover:scale-[1.03] transition-transform duration-700 ease-out"
            width={1200}
            height={1000}
          />
        </div>

      </div>
    </section>

    <!-- Portfolio UGC Section -->
    <section class="py-20 px-6 md:px-12 bg-bone border-t border-soft-sand/30" id="portafolio">
      <div class="mx-auto max-w-7xl">
        <!-- Section Header -->
        <div class="text-center max-w-2xl mx-auto mb-12 flex flex-col gap-3">
          <h2 class="font-serif text-3xl md:text-4xl font-medium tracking-tight text-charcoal">
            Casos de éxito y contenido UGC
          </h2>
          <div class="h-0.5 w-16 bg-terracotta/40 mx-auto mt-2"></div>
        </div>
        
        <!-- Interactive React Portfolio -->
        <PortfolioUGC client:load />
      </div>
    </section>

    <!-- Testimonios & Video Reviews Carousel -->
    <TestimonialCarousel client:visible />

    <!-- FAQ Section -->
    <section class="py-20 px-6 md:px-12 bg-soft-sand/20" id="faq">
      <div class="mx-auto max-w-3xl">
        <!-- Section Header -->
        <div class="text-center mb-12 flex flex-col gap-3">
          <span class="text-xs font-semibold tracking-[0.2em] uppercase text-warm-gray">Resolviendo tus dudas</span>
          <h2 class="font-serif text-3xl font-medium tracking-tight text-charcoal">
            Preguntas Frecuentes
          </h2>
          <div class="h-0.5 w-16 bg-sage/40 mx-auto mt-2"></div>
        </div>
        
        <!-- Interactive React FAQ -->
        <FAQ client:load />
      </div>
    </section>

  </main>
  
  <Footer />

  <!-- About Me Modal Overlay -->
  <div 
    id="about-modal" 
    class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-charcoal/80 backdrop-blur-sm hidden transition-all duration-300"
  >
    <div 
      id="about-modal-container"
      class="relative w-full max-w-2xl bg-bone rounded-[24px] overflow-hidden shadow-2xl border border-soft-sand/60 p-6 sm:p-8 flex flex-col gap-6 transform scale-95 opacity-0 transition-all duration-300"
    >
      <!-- Close button -->
      <button 
        id="close-about-modal"
        class="absolute top-4 right-4 text-warm-gray hover:text-charcoal bg-soft-sand/50 hover:bg-soft-sand h-10 w-10 rounded-full flex items-center justify-center cursor-pointer transition-all border border-soft-sand/40 z-10"
        aria-label="Cerrar modal"
      >
        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>

      <!-- Modal Tabs -->
      <div class="flex border-b border-soft-sand/80 pb-1 mt-4">
        <button
          id="tab-letter-btn"
          class="flex-1 py-3 text-xs font-semibold uppercase tracking-wider border-b-2 border-charcoal text-charcoal cursor-pointer transition-all focus:outline-none"
        >
          Carta de Presentación
        </button>
        <button
          id="tab-experience-btn"
          class="flex-1 py-3 text-xs font-semibold uppercase tracking-wider border-b-2 border-transparent text-warm-gray hover:text-charcoal cursor-pointer transition-all focus:outline-none"
        >
          Experiencias de Clientes
        </button>
      </div>

      <!-- Tab Content 1: Carta de Presentación -->
      <div id="tab-letter-content" class="flex flex-col gap-4 text-warm-gray text-sm sm:text-base leading-relaxed py-2">
        <h4 class="font-serif text-lg font-semibold text-charcoal">Querida marca, querido creador:</h4>
        <p>
          Mi nombre es Des, y entiendo la comunicación como el arte de trazar puentes. A menudo nos obsesionamos con el algoritmo, los números vacíos y las tendencias efímeras, olvidando que detrás de cada pantalla hay una persona real esperando ser conmovida.
        </p>
        <p>
          Como Licenciada en Comunicación Social, no veo las redes sociales como simples repositorios de imágenes, sino como espacios de conversación activa. Mi propósito es diseñar estrategias de contenido y piezas UGC con intención, cuidando la estética y respaldando cada vídeo en una sólida psicología de ventas y oratoria consciente.
        </p>
        <p>
          Trabajemos en equipo para construir un mensaje que no solo sea visto, sino recordado. Conectemos desde la honestidad y el valor real de lo que haces.
        </p>
        <div class="mt-4 flex flex-col">
          <span class="font-serif text-base italic text-charcoal">Con cariño, Des.</span>
        </div>
      </div>

      {/* Tab Content 2: Experiencias de Clientes */}
      <div id="tab-experience-content" class="hidden flex flex-col gap-6 py-2">
        
        {/* Testimonial 1 */}
        <div class="bg-soft-sand/15 border border-soft-sand/50 rounded-[18px] p-5 flex flex-col gap-3">
          <p class="text-sm text-warm-gray leading-relaxed italic">
            "La dedicación de Des en la estrategia y redacción de guiones de nuestro lanzamiento de skincare fue excepcional. Consiguió captar la esencia de nuestra marca desde el primer momento, reflejando una delicadeza y conversión increíbles en Ads."
          </p>
          <div class="flex justify-between items-center mt-1">
            <span class="text-xs font-semibold text-charcoal">— Elena M., Fundadora de Aura Skincare</span>
            <span class="bg-sage/10 text-sage text-[9px] font-bold uppercase tracking-wider px-2 py-1 rounded-full">+35% Conversión en Ads</span>
          </div>
        </div>

        {/* Testimonial 2 */}
        <div class="bg-soft-sand/15 border border-soft-sand/50 rounded-[18px] p-5 flex flex-col gap-3">
          <p class="text-sm text-warm-gray leading-relaxed italic">
            "Trabajar con Des en la creación de contenido vertical UGC fue un acierto rotundo. Su manejo de la cámara y su elocuencia al hablar son espectaculares. El vídeo del equipo superó las 120K visitas orgánicas y nos trajo mucha visibilidad."
          </p>
          <div class="flex justify-between items-center mt-1">
            <span class="text-xs font-semibold text-charcoal">— Javier S., Director Creativo de CREA Barcelona</span>
            <span class="bg-terracotta/10 text-terracotta text-[9px] font-bold uppercase tracking-wider px-2 py-1 rounded-full">120K Views Orgánicos</span>
          </div>
        </div>

      </div>

    </div>
  </div>
</Layout>

<script>
  const openModalBtn = document.getElementById('open-about-modal');
  const closeModalBtn = document.getElementById('close-about-modal');
  const modalOverlay = document.getElementById('about-modal');
  const modalContainer = document.getElementById('about-modal-container');

  const tabLetterBtn = document.getElementById('tab-letter-btn');
  const tabExperienceBtn = document.getElementById('tab-experience-btn');
  const tabLetterContent = document.getElementById('tab-letter-content');
  const tabExperienceContent = document.getElementById('tab-experience-content');

  function openModal() {
    if (modalOverlay && modalContainer) {
      modalOverlay.classList.remove('hidden');
      // Trigger reflow for transition
      void modalOverlay.offsetWidth;
      modalContainer.classList.remove('scale-95', 'opacity-0');
      modalContainer.classList.add('scale-100', 'opacity-100');
      document.body.style.overflow = 'hidden';
    }
  }

  function closeModal() {
    if (modalOverlay && modalContainer) {
      modalContainer.classList.remove('scale-100', 'opacity-100');
      modalContainer.classList.add('scale-95', 'opacity-0');
      
      // Wait for transitions to finish before hiding
      setTimeout(() => {
        modalOverlay.classList.add('hidden');
        document.body.style.overflow = '';
      }, 300);
    }
  }

  openModalBtn?.addEventListener('click', openModal);
  closeModalBtn?.addEventListener('click', closeModal);
  
  modalOverlay?.addEventListener('click', (e) => {
    if (e.target === modalOverlay) closeModal();
  });

  // Tab switcher logic
  tabLetterBtn?.addEventListener('click', () => {
    tabLetterBtn.classList.remove('border-transparent', 'text-warm-gray');
    tabLetterBtn.classList.add('border-charcoal', 'text-charcoal');
    
    tabExperienceBtn?.classList.remove('border-charcoal', 'text-charcoal');
    tabExperienceBtn?.classList.add('border-transparent', 'text-warm-gray');
    
    tabLetterContent?.classList.remove('hidden');
    tabExperienceContent?.classList.add('hidden');
  });

  tabExperienceBtn?.addEventListener('click', () => {
    tabExperienceBtn.classList.remove('border-transparent', 'text-warm-gray');
    tabExperienceBtn.classList.add('border-charcoal', 'text-charcoal');
    
    tabLetterBtn?.classList.remove('border-charcoal', 'text-charcoal');
    tabLetterBtn?.classList.add('border-transparent', 'text-warm-gray');
    
    tabExperienceContent?.classList.remove('hidden');
    tabLetterContent?.classList.add('hidden');
  });
</script>
